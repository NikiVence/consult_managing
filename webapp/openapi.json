    },
    "/api/consultations/": {
      "get": {
        "summary": "Будущие консультации: до 200, по дате",
        "responses": {
          "200": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка полей или JSON"
          },
          "403": {
            "description": "CSRF или недостаточно прав"
          },
          "409": {
            "description": "Слот или участник занят, либо дубликат"
          },
          "429": {
            "description": "Слишком много попыток входа/регистрации"
          },
          "503": {
            "description": "Сервис не готов"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          }
        ]
      },
      "post": {
        "summary": "Создать свой слот (только преподаватель)",
        "responses": {
          "201": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка полей или JSON"
          },
          "403": {
            "description": "CSRF или недостаточно прав"
