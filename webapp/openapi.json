{
  "openapi": "3.0.3",
  "info": {
    "title": "Консультант API",
    "version": "1.0.0",
    "description": "Session authentication; obtain CSRF token before any POST. Dates use ISO 8601 with timezone."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/csrf/": {
      "get": {
        "summary": "Получить CSRF-токен",
        "responses": {
          "200": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка полей или JSON"
          },
          "403": {
            "description": "CSRF или недостаточно прав"
          },
          "409": {
            "description": "Слот или участник занят, либо дубликат"
          },
          "429": {
            "description": "Слишком много попыток входа/регистрации"
          },
          "503": {
            "description": "Сервис не готов"
          }
        }
      }
    },
    "/api/auth/register/": {
      "post": {
        "summary": "Регистрация студента",
        "responses": {
          "201": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка полей или JSON"
          },
          "403": {
            "description": "CSRF или недостаточно прав"
          },
          "409": {
            "description": "Слот или участник занят, либо дубликат"
          },
          "429": {
            "description": "Слишком много попыток входа/регистрации"
          },
          "503": {
            "description": "Сервис не готов"
          }
        },
        "security": [
          {
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "maxLength": 128
                  }
                },
                "required": [
                  "username",
                  "name",
                  "password"
                ]
              }
            }
          }
        }
      }
    },
    "/api/auth/login/": {
      "post": {
        "summary": "Вход и создание сессии",
