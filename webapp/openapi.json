              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка полей или JSON"
          },
          "403": {
            "description": "CSRF или недостаточно прав"
          },
          "409": {
            "description": "Слот или участник занят, либо дубликат"
          },
          "429": {
            "description": "Слишком много попыток входа/регистрации"
          },
          "503": {
            "description": "Сервис не готов"
          },
          "401": {
            "description": "Необходим вход"
          }
        },
        "security": [
          {
            "session": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "consultation_id": {
                    "type": "integer"
                  },
                  "duration_minutes": {
                    "type": "integer",
                    "minimum": 15,
                    "maximum": 90
                  }
                },
                "required": [
                  "consultation_id",
                  "duration_minutes"
                ]
              }
            }
          }
        }
      }
