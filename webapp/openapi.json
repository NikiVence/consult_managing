          },
          "503": {
            "description": "Сервис не готов"
          },
          "401": {
            "description": "Необходим вход"
          }
        },
        "security": [
          {
            "session": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "required": []
              }
            }
          }
        }
      }
    },
    "/api/auth/me/": {
      "get": {
        "summary": "Текущий пользователь или null",
