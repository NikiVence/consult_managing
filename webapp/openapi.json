  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRFToken"
      }
    }
  }
}
