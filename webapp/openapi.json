          "409": {
            "description": "Слот или участник занят, либо дубликат"
          },
          "429": {
            "description": "Слишком много попыток входа/регистрации"
          },
          "503": {
            "description": "Сервис не готов"
          },
          "401": {
            "description": "Необходим вход"
          }
        },
        "security": [
          {
            "session": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  },
                  "starts_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "topic",
                  "location",
                  "starts_at"
                ]
              }
            }
          }
        }
      }
    },
    "/api/bookings/": {
      "get": {
        "summary": "Свои записи; преподаватель видит записи к себе (до 200)",
